CREATE TABLE employees (
    id INT,
    name VARCHAR(100),
    department VARCHAR(50),
    salary DECIMAL(10,2),
    hire_date DATE
);
SELECT * FROM employees
WHERE name LIKE '%John%';
SELECT * FROM employees
WHERE department = 'Sales';
SELECT * FROM employees
ORDER BY salary DESC;
SELECT * FROM employees
ORDER BY hire_date ASC;
SELECT * FROM employees
WHERE department = 'HR'
ORDER BY salary ASC;
